# Copy to .env and fill locally. Never commit actual credentials.
MAX_BOT_TOKEN=
MAX_BOT_ID=
# Empty means no additional global chat restriction.
MAX_CHAT_ID=
LM_PROVIDER=lmstudio
DEEPSEEK_API_KEY=
LM_API_KEY=
LOCAL_LM_API_KEY=
# Explicit owner chat IDs for file/command permissions and personal features.
FS_ALLOWED_CHAT_IDS=
NOTIFICATIONS_CHAT_ID=
SUMMARY_CHAT_ID=
MOOD_CHAT_ID=
# Optional runtime settings:
DEEPSEEK_ENABLED=true
ROUTER_CONFIDENCE_THRESHOLD=0.55
DEEPSEEK_COOLDOWN_SECONDS=60
ASSISTANT_NAME=Агафья

# Independent local panel: launch with .venv/bin/python launch_server.py.
SUPERVISOR_PORT=5002
WORKER_MODE=process
WORKER_MAX_ATTEMPTS=3
RUN_TIMEOUT_SECONDS=600
PANEL_AUTH_ENABLED=true
# If unset, an owner-only key is generated in .secrets/panel.token.
# PANEL_ACCESS_TOKEN=
# PANEL_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# ASSISTANT_TASKS_DIR=/absolute/private/path/tasks

# Optional Telegram private-chat entry point; both token and allow-list are required.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_SENDER_IDS=

# Optional local embeddings. Without a model, text search remains available.
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
# Optional downloaded E5 checkpoint; uses local CPU instead of the HTTP endpoint.
RAG_EMBEDDING_LOCAL_DIR=

# Local personal memory; if unset, the allow-list uses FS_ALLOWED_CHAT_IDS.
MEMORY_ENABLED=true
# MEMORY_ALLOWED_CHAT_IDS=
# MEMORY_DB_PATH=/absolute/private/path/personal.sqlite3
MEMORY_TIMEOUT=20

# Local Qwen memory tools
MEMORY_AGENT_ENABLED=true
MEMORY_AGENT_MAX_ROUNDS=8

# Messenger development workflow (local Qwen only)
CODE_CHANGES_ENABLED=true
# Defaults to FS_ALLOWED_CHAT_IDS when omitted
# CODE_ALLOWED_CHAT_IDS=
CODE_TEST_TIMEOUT=180
CODE_MAX_ROUNDS=24

# Required trusted MAX sender IDs; an empty list denies code changes
CODE_ALLOWED_SENDER_IDS=

# Local voice-cloning preparation (optional .venv-tts environment)
TTS_MODEL_DIR=.models/tts/qwen3-tts-0.6b-base
TTS_VOICE_DIR=.voices

# Separate local executor process. Commands still have ordinary OS user rights.
LOCAL_AGENT_ENABLED=1
# Optional local OCR: first build with python macos_setup.py build-ocr.
RAG_OCR_ENABLED=0
